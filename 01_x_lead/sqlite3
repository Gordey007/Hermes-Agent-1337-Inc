#!/usr/bin/env python3

"""
chmod +x /sandbox/tools/x_lead/sqlite3

uv run /sandbox/tools/x_lead/sqlite3 /sandbox/tools/x_lead/leads.db "drop table leads"
rm -f /sandbox/tools/x_lead/leads.db /sandbox/tools/x_lead/leads.db-wal /sandbox/tools/x_lead/leads.db-shm

uv run /sandbox/tools/x_lead/sqlite3 /sandbox/tools/x_lead/leads.db "SELECT tweet_id, author_username FROM leads"
"""

import sqlite3, sys
db = sys.argv[1] if len(sys.argv) > 1 else ':memory:'
con = sqlite3.connect(db)
if len(sys.argv) > 2:                      # sqlite3 db.sqlite "SELECT ..."
    cur = con.execute(sys.argv[2])
    for row in cur:
        print('|'.join(map(str, row)))
    con.commit()                           # persist INSERT/UPDATE/DELETE
else:                                       # interactive mode
    import code; code.interact(local={'con': con, 'cur': con.cursor()})
