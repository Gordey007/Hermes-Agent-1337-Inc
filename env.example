# Hermes Agent Accelerated Business — root environment template.
# Copy to .env and fill in real values. NEVER commit the filled .env.

# --- GitHub (researcher smart-search) ---
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GH_CACHE_DIR=/sandbox/.cache/gh_search
GH_CACHE_TTL=21600                         # seconds (6h)

# --- NVIDIA (NemoHermes inference) ---
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Stripe (sales pipeline) ---
# TEST key ONLY (sk_test_...). The live key rk_live_ is FORBIDDEN on the VPS.
STRIPE_API_KEY_TEST=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- X / Twitter (lead search + outreach) ---
X_BEARER_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
X_USER_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- SQLite databases ---
LEADS_DB_PATH=/sandbox/x_lead/leads.db
KANBAN_DB_PATH=/sandbox/.hermes/kanban.db

# --- MinIO (artifacts + reports) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=
MINIO_BUCKET_ARTIFACTS=
MINIO_BUCKET_REPORTS=
